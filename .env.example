# ─── Database ─────────────────────────────────────────────
# Local development: SQLite
DATABASE_URL=file:./dev.db

# Production (Vercel): Set this in Vercel environment variables to your Neon PostgreSQL URL:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-XXXX-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Jellyfin Connection ───────────────────────────────
# When these are set, the app will automatically connect to Jellyfin on startup.
# No manual connection needed in the UI. Set these in Vercel environment variables too.

# Server URL (required)
JELLYFIN_SERVER_URL=https://manitou.dyabavadra.com

# Direct token auth (RECOMMENDED for Vercel — bypasses the auth endpoint which may return 500)
# Obtain these from your Jellyfin admin dashboard or by authenticating once locally.
JELLYFIN_ACCESS_TOKEN=your_access_token_here
JELLYFIN_USER_ID=your_user_id_here

# Username/password auth (fallback — used if JELLYFIN_ACCESS_TOKEN is not set)
JELLYFIN_USERNAME=your_username
JELLYFIN_PASSWORD=your_password
