# Jellyfin server credentials for auto-connect
JELLYFIN_SERVER_URL=
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# HDHomerun tuner IP (server-side, used if the server can reach the local network)
HDHOMERUN_IP=

# HDHomerun tuner IP (client-side, used by the browser to fetch lineup.json
# when the server can't reach the local network device)
NEXT_PUBLIC_HDHOMERUN_IP=
