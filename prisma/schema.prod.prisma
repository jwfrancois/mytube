generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  type        String   // MOVIE, TV_SHOW, MUSIC, PODCAST, AUDIOBOOK
  genre       String   @default("")
  thumbnail   String   @default("")
  videoUrl    String   @default("")
  duration    String   @default("")
  releaseYear Int      @default(2024)
  artist      String   @default("")
  views       Int      @default(0)
  channel     String   @default("")
  playlistItems PlaylistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  description String          @default("")
  items       PlaylistItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  mediaId    String
  order      Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([playlistId, mediaId, order])
}

model JellyfinServer {
  id            String   @id @default(cuid())
  name          String   @default("My Jellyfin")
  serverUrl     String
  userId        String   @default("")
  accessToken   String   @default("")
  username      String   @default("")
  connected     Boolean  @default(false)
  lastConnected DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MediaCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cacheKey])
  @@index([expiresAt])
}

model UserActivity {
  id         String   @id @default(cuid())
  jellyfinId String
  title      String
  type       String   @default("MOVIE")
  thumbnail  String   @default("")
  action     String   // "play", "like", etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([jellyfinId, action])
}

model HDHomerunTuner {
  id            String   @id @default(cuid())
  tunerIp       String   @unique
  name          String   @default("HDHomeRun")
  model         String   @default("")
  firmware      String   @default("")
  deviceId      String   @default("")
  tunerCount    Int      @default(2)
  connected     Boolean  @default(false)
  lastConnected DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WatchLaterItem {
  id               String   @id @default(cuid())
  jellyfinId       String   @unique
  title            String
  type             String   @default("MOVIE")
  thumbnail        String   @default("")
  overview         String   @default("")
  genre            String   @default("")
  releaseYear      Int      @default(0)
  duration         String   @default("")
  communityRating  Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
